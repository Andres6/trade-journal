# Copy this file to .env and fill in your own values.

# Port the API server listens on
PORT=4000

# If this app is reverse-proxied under a path on your site (e.g. your nginx
# location is /journal/), set that here so post-login redirects land in the
# right place. Leave blank if it's served at the domain root.
APP_BASE_PATH=/journal

# Where the built frontend lives (served as static files by this server)
CLIENT_DIST=../client/dist

# --- App login (protects your journal + your Schwab tokens) ---
# Generate a bcrypt hash for your chosen password, e.g.:
#   node -e "console.log(require('bcryptjs').hashSync('your-password-here', 10))"
APP_PASSWORD_HASH=
SESSION_SECRET=change-this-to-a-long-random-string

# --- Schwab Developer app (developer.schwab.com) ---
# Create an app there, request "Trader API - Individual", and register
# SCHWAB_REDIRECT_URI as its callback URL. It must be HTTPS in production.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://your-domain.example/api/schwab/callback
